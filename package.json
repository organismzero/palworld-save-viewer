{
  "name": "palworld-save-viewer",
  "version": "0.1.0",
  "description": "Visual browser for Palworld save files — reads raw .sav in the browser, nothing uploaded",
  "keywords": [
    "palworld",
    "sav",
    "gvas",
    "save-editor",
    "viewer",
    "oodle",
    "kraken",
    "browser"
  ],
  "homepage": "https://github.com/organismzero/palworld-save-viewer#readme",
  "bugs": {
    "url": "https://github.com/organismzero/palworld-save-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/organismzero/palworld-save-viewer.git"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.20.0",
  "author": "OrganismZero",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:golden": "vitest run --project golden",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "fixture": "tsx scripts/make-fixture.ts",
    "gen:sav-tables": "tsx scripts/gen-sav-tables.ts",
    "verify:breeding": "tsx scripts/verify-breeding.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "idb": "^8.0.3",
    "ooz-wasm": "^2.0.0",
    "pixi.js": "^8.14.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  }
}
